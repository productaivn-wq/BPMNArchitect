      <bpmndi:BPMNShape id="Lane_CUSTOMER_di" bpmnElement="Lane_CUSTOMER" isHorizontal="true">
        <dc:Bounds x="190" y="80" width="2710" height="306" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_REVIEW_di" bpmnElement="Lane_REVIEW" isHorizontal="true">
