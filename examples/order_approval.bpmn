<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
                  id="Definitions_order_approval"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  exporter="Camunda Modeler"
                  exporterVersion="5.20.0">
  <bpmn:collaboration id="Collaboration_order_approval">
    <bpmn:participant id="Participant_order_approval" name="Order Approval Workflow" processRef="Process_order_approval" />
  </bpmn:collaboration>
  <bpmn:process id="Process_order_approval" name="Order Approval Workflow" isExecutable="true">
    <bpmn:laneSet id="LaneSet_order_approval">
      <bpmn:lane id="Lane_CUSTOMER" name="Customer / Requester">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST-001</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EX-001</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST-005</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_REVIEW" name="Finance &amp; Operations">
        <bpmn:flowNodeRef>ST-003</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW-002</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EX-002</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_SYSTEM" name="Order Engine (Automated)">
        <bpmn:flowNodeRef>ST-002</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW-001</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST-004</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_1" name="Process Initiated">
      <bpmn:outgoing>Flow_Start_ST_001</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="ST-001" name="ST-001: Submit Order Request&#10;(Order Intake)">
      <bpmn:incoming>Flow_Start_ST_001</bpmn:incoming>
      <bpmn:incoming>Flow_EX_001_ST_001</bpmn:incoming>
      <bpmn:outgoing>Flow_ST_001_ST_002</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ST-002" name="ST-002: Validate Inventory &amp; Credit&#10;(Stock + Credit Check)">
      <bpmn:incoming>Flow_ST_001_ST_002</bpmn:incoming>
      <bpmn:outgoing>Flow_ST_002_GW_001</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GW-001" name="GW-001: Inventory &amp; Credit Valid?">
      <bpmn:incoming>Flow_ST_002_GW_001</bpmn:incoming>
      <bpmn:outgoing>Flow_GW_001_ST_003_Pass</bpmn:outgoing>
      <bpmn:outgoing>Flow_GW_001_EX_001_Fail</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="EX-001" name="EX-001: Auto-Heal (INVALID_OR_OOS)&#10;(Recover -&gt; ST-001)">
      <bpmn:incoming>Flow_GW_001_EX_001_Fail</bpmn:incoming>
      <bpmn:outgoing>Flow_EX_001_ST_001</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="ST-003" name="ST-003: Review High-Value Order&#10;(Risk Assessment)">
      <bpmn:incoming>Flow_GW_001_ST_003_Pass</bpmn:incoming>
      <bpmn:incoming>Flow_EX_002_ST_003</bpmn:incoming>
      <bpmn:outgoing>Flow_ST_003_GW_002</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW-002" name="GW-002: Approval Granted?">
      <bpmn:incoming>Flow_ST_003_GW_002</bpmn:incoming>
      <bpmn:outgoing>Flow_GW_002_ST_004_Pass</bpmn:outgoing>
      <bpmn:outgoing>Flow_GW_002_EX_002_Fail</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="EX-002" name="EX-002: Auto-Heal (REVISION_REQUIRED)&#10;(Recover -&gt; ST-003)">
      <bpmn:incoming>Flow_GW_002_EX_002_Fail</bpmn:incoming>
      <bpmn:outgoing>Flow_EX_002_ST_003</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ST-004" name="ST-004: Confirm Payment &amp; Dispatch&#10;(Fulfillment Dispatch)">
      <bpmn:incoming>Flow_GW_002_ST_004_Pass</bpmn:incoming>
      <bpmn:outgoing>Flow_ST_004_ST_005</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="ST-005" name="ST-005: Deliver Confirmation Receipt&#10;(Customer Notification)">
      <bpmn:incoming>Flow_ST_004_ST_005</bpmn:incoming>
      <bpmn:outgoing>Flow_ST_005_End</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EndEvent_1" name="Process Completed">
      <bpmn:incoming>Flow_ST_005_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Start_ST_001" sourceRef="StartEvent_1" targetRef="ST-001" />
    <bpmn:sequenceFlow id="Flow_ST_001_ST_002" sourceRef="ST-001" targetRef="ST-002" />
    <bpmn:sequenceFlow id="Flow_ST_002_GW_001" sourceRef="ST-002" targetRef="GW-001" />
    <bpmn:sequenceFlow id="Flow_ST_003_GW_002" sourceRef="ST-003" targetRef="GW-002" />
    <bpmn:sequenceFlow id="Flow_ST_004_ST_005" sourceRef="ST-004" targetRef="ST-005" />
    <bpmn:sequenceFlow id="Flow_GW_001_ST_003_Pass" name="Pass" sourceRef="GW-001" targetRef="ST-003" />
    <bpmn:sequenceFlow id="Flow_GW_001_EX_001_Fail" name="INVALID_OR_OOS" sourceRef="GW-001" targetRef="EX-001" />
    <bpmn:sequenceFlow id="Flow_GW_002_ST_004_Pass" name="Pass" sourceRef="GW-002" targetRef="ST-004" />
    <bpmn:sequenceFlow id="Flow_GW_002_EX_002_Fail" name="REVISION_REQUIRED" sourceRef="GW-002" targetRef="EX-002" />
    <bpmn:sequenceFlow id="Flow_EX_001_ST_001" name="Retry -&gt; ST-001" sourceRef="EX-001" targetRef="ST-001" />
    <bpmn:sequenceFlow id="Flow_EX_002_ST_003" name="Retry -&gt; ST-003" sourceRef="EX-002" targetRef="ST-003" />
    <bpmn:sequenceFlow id="Flow_ST_005_End" sourceRef="ST-005" targetRef="EndEvent_1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_order_approval">
    <bpmndi:BPMNPlane id="BPMNPlane_order_approval" bpmnElement="Collaboration_order_approval">
      <bpmndi:BPMNShape id="Participant_order_approval_di" bpmnElement="Participant_order_approval" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="2740" height="882" />
